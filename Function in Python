def deposit(balance, amount):
    balance +=amount
    print(f"Deposited {amount}. New balance is {balance}")
    return balance

def withdraw(balance,amount):
    if amount > balance:
        print("Insufficient balance")
    else:
        balance -=amount
    return balance

def display_balance(balance):
    print(f"Current balance is {balance}")

balance= 2000

while True:
